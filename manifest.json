{
  "manifest_version": 3,
  "name": "Time Tracker",
  "version": "1.0",
  "permissions": ["tabs", "storage", "idle"],
  "host_permissions": ["https://openrouter.ai/*"],
  "icons": {
    "16": "public/tab-summary-icon.png",
    "32": "public/tab-summary-icon.png",
    "48": "public/tab-summary-icon.png",
    "128": "public/tab-summary-icon.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "public/tab-summary-icon.png",
      "32": "public/tab-summary-icon.png",
      "48": "public/tab-summary-icon.png",
      "128": "public/tab-summary-icon.png"
    }
  },
  "background": {
    "service_worker": "dist/background.js"
  }
}